YOUTUBE_API_KEY=replace-with-your-key
CACHE_TTL_SECONDS=1800
ALLOWED_ORIGIN=http://localhost:3000

# Content pipeline LLM. Set to "stub" for canned local-only responses (no
# API key needed) or "gemini" for real calls. Swap providers by editing
# app/ai/registry.py.
AI_PROVIDER=stub
GEMINI_API_KEY=replace-with-your-key
GEMINI_MODEL=gemini-2.0-flash
