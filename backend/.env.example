ALLOWED_ORIGIN=http://localhost:3000

# Content pipeline LLM. Set to "stub" for canned local responses (no API
# key needed) or "gemini" for real text-stage calls. Swap by editing
# app/ai/registry.py.
AI_PROVIDER=stub

# Optional: env fallback for the text-stage Gemini calls (if AI_PROVIDER=gemini).
# Image generation has its own per-key UI at /keys — env keys are not used there.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
